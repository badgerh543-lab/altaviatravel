---
import media from '../data/media.json';
import '../styles/main.css';
import '../styles/seasons.css';
import Brand from '../components/Brand.astro';
import {t,languages,languageNames,type Lang} from '../data/i18n';
import {indexingEnabled} from '../../shared/seo.mjs';
import company from '../data/company.json';import Icon from '../components/Icon.astro';import CompanyContacts from '../components/CompanyContacts.astro';
interface Props {lang:Lang;title:string;description?:string;path?:string;image?:string;breadcrumbs?:{name:string;url:string}[];noindex?:boolean;}
const {lang,title,description=t(lang,'footerText'),path='',image='thailand',breadcrumbs=[],noindex=false}=Astro.props;
const base=Astro.site!;const canonical=new URL(`/${lang}/${path?path.replace(/\/$/,'')+'/':''}`,base);
const production=import.meta.env.PROD&&indexingEnabled(import.meta.env.SITE_URL);
const nav=[['destinations','destinations'],['tours','tours'],['custom','custom'],['gallery','gallery'],['journal','journal']];
const structured=[{'@context':'https://schema.org','@type':'Organization',name:company.name,legalName:company.legalName,telephone:company.phone,address:{'@type':'PostalAddress',streetAddress:company.address,addressLocality:'Andijon',addressCountry:'UZ'},sameAs:[company.instagram,company.telegram],logo:new URL('/images/brand/altavia-mark.svg',base).href,url:base.href},...(breadcrumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,base).href}))}]:[])];
---
<!doctype html><html lang={lang} data-season="autumn"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · ALTAVIA</title><meta name="description" content={description}/><meta name="theme-color" content="#ff681f"/><meta name="robots" content={!production||noindex?'noindex, nofollow':'index, follow'}/><link rel="canonical" href={canonical}/>{languages.map(l=><link rel="alternate" hreflang={l} href={new URL(`/${l}/${path?path.replace(/\/$/,'')+'/':''}`,base)}/>)}<link rel="alternate" hreflang="x-default" href={new URL(`/uz/${path?path.replace(/\/$/,'')+'/':''}`,base)}/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} · ALTAVIA`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL((media.find(m=>m.id===image)?.variants.at(-1)?.src||'/images/travel/samarkand-1600.webp'),base)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg?v=winged-a" type="image/svg+xml"/><link rel="preload" href={`/fonts/manrope-${['ru','ky','tg'].includes(lang)?'cyrillic':'latin'}.woff2`} as="font" type="font/woff2" crossorigin/>{structured.map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\u003c')}/>)}</head>
<body><a class="skip" href="#main">{t(lang,'skip')}</a><div class="topline"><span>{t(lang,'heroKicker')}</span><a href={`/${lang}/about/`}>{t(lang,'about')} <Icon name="diagonal" size={12}/></a></div><header class="site-header"><div class="nav-wrap"><Brand lang={lang}/><nav class="desktop-nav" aria-label={t(lang,'navigation')}>{nav.map(([key,url])=><a href={`/${lang}/${url}/`} aria-current={path===url?'page':undefined}>{t(lang,key)}</a>)}</nav><div class="nav-actions"><details class="language-menu"><summary aria-label={lang.toUpperCase()+': '+t(lang,'chooseLanguage')}><Icon name="globe" size={17}/><span>{lang.toUpperCase()}</span><Icon name="chevron" size={12}/></summary><div>{languages.map(l=><a href={`/${l}/${path?path+'/':''}`} data-language-link lang={l} hreflang={l} aria-current={l===lang?'true':undefined}>{languageNames[l]}</a>)}</div></details><a class="button header-cta" href={`/${lang}/contact/`}>{t(lang,'plan')}<Icon name="diagonal" size={17}/></a><button class="menu-toggle icon-button" data-open-label={t(lang,'menu')} data-close-label={t(lang,'close')} aria-label={t(lang,'menu')} aria-expanded="false" aria-controls="mobile-menu"><Icon name="menu"/></button></div></div><nav id="mobile-menu" class="mobile-menu" aria-label={t(lang,'navigation')} hidden>{[...nav,['inbound','inbound'],['outbound','outbound'],['domestic','domestic'],['about','about'],['contact','contact']].map(([key,url])=><a href={`/${lang}/${url}/`}>{t(lang,key)}<Icon name="arrow" size={16}/></a>)}</nav></header>
<main id="main">{breadcrumbs.length>0&&<nav class="breadcrumbs wrap" aria-label={t(lang,'home')}>{breadcrumbs.map((b,i)=><>{i>0&&<span aria-hidden="true">/</span>}{i===breadcrumbs.length-1?<span aria-current="page">{b.name}</span>:<a href={b.url}>{b.name}</a>}</>)}</nav>}<slot/></main>
<footer class="site-footer"><div class="wrap footer-grid"><div class="footer-brand"><Brand lang={lang}/><p>{t(lang,'footerText')}</p><div class="footer-languages">{languages.map(l=><a href={`/${l}/${path?path+'/':''}`} data-language-link lang={l} aria-label={`${l.toUpperCase()} — ${languageNames[l]}`}>{l.toUpperCase()}</a>)}</div></div><div><h2>{t(lang,'explore')}</h2>{['destinations','inbound','outbound','domestic','gallery'].map(k=><a href={`/${lang}/${k}/`}>{t(lang,k)}</a>)}</div><div><h2>ALTAVIA</h2>{['about','custom','journal','faq','contact'].map(k=><a href={`/${lang}/${k}/`}>{t(lang,k)}</a>)}</div><div><h2>{t(lang,'practical')}</h2><a href={`/${lang}/privacy/`}>{t(lang,'privacy')}</a><a href={`/${lang}/terms/`}>{t(lang,'terms')}</a><a href={`/${lang}/booking-conditions/`}>{t(lang,'bookingConditions')}</a><a href={`/${lang}/credits/`}>{t(lang,'credits')}</a></div></div><div class="wrap footer-company"><CompanyContacts lang={lang}/></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {company.name}</span><span>{t(lang,'tagline')}</span><a href="#main" aria-label={t(lang,'backToTop')}>↑</a></div></footer><script>document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach(link=>{link.search=location.search;});const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const menu=document.querySelector<HTMLElement>('#mobile-menu');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',(open?toggle.dataset.closeLabel:toggle.dataset.openLabel)!);if(menu)menu.hidden=!open;});document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelectorAll('details.language-menu').forEach(el=>el.removeAttribute('open'));if(menu&&!menu.hidden){menu.hidden=true;toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label',toggle.dataset.openLabel!);toggle?.focus();}}});document.addEventListener('click',e=>{document.querySelectorAll('details.language-menu[open]').forEach(el=>{if(!el.contains(e.target as Node))el.removeAttribute('open')})});</script><script>import '../scripts/season';</script></body></html>
