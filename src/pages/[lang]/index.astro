---
import Base from '../../layouts/Base.astro';import Photo from '../../components/Photo.astro';import Icon from '../../components/Icon.astro';import TourCard from '../../components/TourCard.astro';import CTA from '../../components/CTA.astro';
import {t,languages,type Lang} from '../../data/i18n';import {tours,destinations,faqs} from '../../data/travel';import {articles} from '../../data/articles';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const priority=['silk-road-cities','thailand-islands','cappadocia-skies','fergana-valley','samarkand-weekend','khiva-discovery'];
const featuredTours=tours.slice().sort((a,b)=>(priority.includes(a.slug)?priority.indexOf(a.slug):99)-(priority.includes(b.slug)?priority.indexOf(b.slug):99)).slice(0,9);
const placesFirst=['samarkand','turkey','thailand','uae','malaysia','egypt'];
const featuredDestinations=destinations.slice().sort((a,b)=>(placesFirst.includes(a.slug)?placesFirst.indexOf(a.slug):99)-(placesFirst.includes(b.slug)?placesFirst.indexOf(b.slug):99)).slice(0,6);
---
<Base lang={lang} title={t(lang,'heroKicker')}>
<section class="hero wrap-wide"><picture class="hero-visual"><source media="(max-width: 700px)" srcset="/images/travel/thailand-mobile-480.webp 480w, /images/travel/thailand-mobile-768.webp 768w, /images/travel/thailand-mobile-960.webp 960w" sizes="100vw"/><Photo id="thailand" alt={(destinations.find(d=>d.slug==='thailand')?.name[lang]||'Thailand')} priority sizes="100vw" class="hero-photo"/></picture><div class="hero-shade"></div><div class="hero-content"><span class="eyebrow light"><span class="tiny-sun">✳</span>{t(lang,'heroKicker')}</span><h1>{t(lang,'heroLine1')}<br/><span>{t(lang,'heroLine2')}</span></h1><p>{t(lang,'heroText')}</p><a class="button" href={`/${lang}/tours/`}>{t(lang,'explore')}<Icon name="diagonal"/></a></div><div class="hero-stamp" aria-hidden="true"><Icon name="sun" size={40}/><span>ALTAVIA<br/>EXPLORER</span></div><a class="hero-location" href={destinations.some(d=>d.slug==='thailand')?`/${lang}/destinations/thailand/`:`/${lang}/destinations/`}><Icon name="pin"/><span>{(destinations.find(d=>d.slug==='thailand')?.name[lang]||'Thailand')}<small>Phi Phi</small></span><Icon name="diagonal"/></a></section>
<form class="discovery-bar simple-search wrap" action={'/'+lang+'/tours/'} method="get" role="search"><label for="home-tour-query"><Icon name="search"/><span>{t(lang,'searchTours')}<input id="home-tour-query" name="q" type="search" maxlength="100" placeholder={t(lang,'searchPlaceholder')} list="tour-suggestions"/></span></label><datalist id="tour-suggestions">{[...new Set([...tours.map(tour=>tour.title[lang]),...destinations.map(d=>d.name[lang])])].map(name=><option value={name}/>)}</datalist><button class="button" type="submit">{t(lang,'search')}<Icon name="arrow"/></button></form>
<div class="promise-strip wrap"><span><Icon name="check"/>{t(lang,'why1')}</span><span><Icon name="check"/>{t(lang,'why2')}</span><span><Icon name="check"/>{t(lang,'why3')}</span></div>
<section data-defer class="section wrap"><div class="section-head"><div><span class="eyebrow orange">01 / {t(lang,'destinations')}</span><h2>{t(lang,'discovery')}</h2><p>{t(lang,'discoveryText')}</p></div><a class="text-link" href={`/${lang}/destinations/`}>{t(lang,'viewAll')}<Icon name="arrow"/></a></div><div class="destination-rounds">{featuredDestinations.map(d=>{return <a href={`/${lang}/destinations/${d.slug}/`}><div><Photo id={d.image} alt={d.name[lang]} sizes="(max-width: 650px) 35vw, 15vw"/><span><Icon name="diagonal" size={20}/></span></div><h3>{d.name[lang]}</h3></a>})}</div></section>
<section data-defer class="section collection"><div class="wrap"><div class="section-head"><div><span class="eyebrow orange">02 / {t(lang,'collection')}</span><h2>{t(lang,'featured')}</h2><p>{t(lang,'featuredText')}</p></div><a class="text-link" href={`/${lang}/tours/`}>{t(lang,'allTrips')}<Icon name="arrow"/></a></div><div class="chips journey-tabs" aria-label={t(lang,'travelType')}>{['allTrips','inbound','outbound','domestic'].map((k,i)=><button type="button" data-featured-type={i===0?'':k} aria-pressed={i===0?'true':'false'} class:list={['chip',i===0&&'active']}>{t(lang,k)}</button>)}</div><div class="tour-grid featured-grid">{featuredTours.map((tour,i)=><div data-featured-card={tour.type} hidden={i>2}><TourCard tour={tour} lang={lang}/></div>)}</div></div></section>
<section data-defer class="section wrap uzbekistan-story"><div class="story-pictures"><div class="story-main"><Photo id="samarkand" alt={'Samarkand'} sizes="(max-width: 800px) 90vw, 50vw"/></div><div class="story-small"><Photo id="khiva" alt={'Khiva'} sizes="(max-width: 800px) 50vw, 25vw"/></div><div class="story-label"><Icon name="spark" size={25}/><span>UZBEKISTAN<br/>41° N · 64° E</span></div></div><div class="story-copy"><span class="eyebrow orange">{t(lang,'silkEyebrow')}</span><h2>{t(lang,'silkTitle')}</h2><p>{t(lang,'silkText')}</p><div class="city-links">{destinations.filter(d=>d.region==='uzbekistan').map(d=><a href={`/${lang}/destinations/${d.slug}/`}>{d.name[lang]}<Icon name="diagonal" size={14}/></a>)}</div><a class="button" href={`/${lang}/inbound/`}>{t(lang,'inbound')}<Icon name="arrow"/></a></div></section>
<section data-defer class="planner-promo wrap-wide"><div class="planner-copy"><span class="eyebrow">03 / {t(lang,'custom')}</span><h2>{t(lang,'customTitle')}</h2><p>{t(lang,'customText')}</p><a class="button button-dark" href={`/${lang}/custom/`}>{t(lang,'plan')}<Icon name="diagonal"/></a><div class="mini-steps">{['step1','step2','step3'].map((s,i)=><span><b>0{i+1}</b>{t(lang,s)}</span>)}</div></div><div class="planner-photo"><Photo id="cappadocia" alt={(destinations.find(d=>d.slug==='turkey')?.name[lang]||'Turkey')}/><div class="photo-note"><Icon name="sun" size={26}/>{t(lang,'tagline')}</div></div></section>
<section data-defer class="section wrap why-section"><div><span class="eyebrow orange">ALTAVIA</span><h2>{t(lang,'whyTitle')}</h2></div><div class="why-items">{['why1','why2','why3'].map((key,i)=><div><span class="why-icon"><Icon name={['heart','check','globe'][i]} size={25}/></span><h3>{t(lang,key)}</h3><p>{t(lang,['customText','whyText','quoteNote'][i])}</p></div>)}</div></section>
<section data-defer class="section gallery-preview"><div class="wrap section-head"><div><span class="eyebrow orange">04 / {t(lang,'gallery')}</span><h2>{t(lang,'galleryTitle')}</h2></div><a class="text-link" href={`/${lang}/gallery/`}>{t(lang,'gallery')}<Icon name="arrow"/></a></div><div class="photo-ribbon">{['fergana','thailand','bukhara','mountains','malaysia'].map(id=><a href={`/${lang}/gallery/`} aria-label={t(lang,'gallery')}><Photo id={id} alt="" sizes="(max-width: 700px) 60vw, 25vw"/></a>)}</div></section>
<section data-defer class="section wrap"><div class="section-head"><div><span class="eyebrow orange">05 / {t(lang,'journal')}</span><h2>{t(lang,'journalTitle')}</h2></div><a class="text-link" href={`/${lang}/journal/`}>{t(lang,'viewAll')}<Icon name="arrow"/></a></div><div class="journal-grid">{articles.slice(0,3).map(a=><article class="journal-card"><a href={`/${lang}/journal/${a.slug}/`}><Photo id={a.image} alt=""/><span class="eyebrow">{t(lang,'journal')} · {a.minutes} {t(lang,'minutes')}</span><h3>{a.title[lang]}</h3><p>{a.intro[lang]}</p><span class="text-link">{t(lang,'read')}<Icon name="arrow" size={16}/></span></a></article>)}</div></section>
<section data-defer class="section wrap faq-home"><div><span class="eyebrow orange">{t(lang,'practical')}</span><h2>{t(lang,'faq')}</h2><a class="text-link" href={`/${lang}/faq/`}>{t(lang,'viewAll')}<Icon name="arrow"/></a></div><div class="accordions">{faqs.slice(0,3).map(f=><details><summary>{f.q[lang]}<Icon name="chevron"/></summary><p>{f.a[lang]}</p></details>)}</div></section><CTA lang={lang}/>
<script>document.querySelectorAll<HTMLButtonElement>('[data-featured-type]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-featured-type]').forEach(b=>{b.setAttribute('aria-pressed',String(b===button));b.classList.toggle('active',b===button)});let shown=0;document.querySelectorAll<HTMLElement>('[data-featured-card]').forEach(card=>{const match=!button.dataset.featuredType||card.dataset.featuredCard===button.dataset.featuredType;card.hidden=!match||shown>=3;if(match)shown++;});}));</script>
</Base>
