---
import {publicPages} from '../../../shared/seo.mjs';
import Base from '../../layouts/Base.astro';import TourAttractions from '../../components/TourAttractions.astro';import TourHotels from '../../components/TourHotels.astro';import CompanyContacts from '../../components/CompanyContacts.astro';import Photo from '../../components/Photo.astro';import Icon from '../../components/Icon.astro';import CTA from '../../components/CTA.astro';import Catalog from '../../components/Catalog.astro';import TourCard from '../../components/TourCard.astro';import Inquiry from '../../components/Inquiry.astro';import Gallery from '../../components/Gallery.astro';
import {t,duration,languages,type Lang} from '../../data/i18n';import {tours,destinations,getDestination,getTourDetails,faqs,serviceNotes} from '../../data/travel';import {articles} from '../../data/articles';import {policies} from '../../data/policies';import media from '../../data/media.json';import gallery from '../../data/gallery.json';import company from '../../data/company.json';
export function getStaticPaths(){const pages=publicPages;return languages.flatMap(lang=>[...pages,...tours.map(x=>'tours/'+x.slug),...destinations.map(x=>'destinations/'+x.slug),...articles.map(x=>'journal/'+x.slug)].map(page=>({params:{lang,page}})));}
const lang=Astro.params.lang as Lang;const page=Astro.params.page!;const tour=tours.find(x=>page==='tours/'+x.slug);const destination=destinations.find(x=>page==='destinations/'+x.slug);const article=articles.find(x=>page==='journal/'+x.slug);
const key=page==='booking-conditions'?'bookingConditions':page;const title=tour?.title[lang]||destination?.name[lang]||article?.title[lang]||t(lang,key);
const description=tour?.summary[lang]||destination?.summary[lang]||article?.intro[lang]||t(lang,page==='gallery'?'galleryText':page==='custom'?'plannerIntro':page==='contact'?'contactText':'featuredText');
const image=tour?.image||destination?.image||article?.image||(['inbound','domestic','about'].includes(page)?'samarkand':'thailand');
const breadcrumbs=[{name:t(lang,'home'),url:`/${lang}/`},...(page.includes('/')?[{name:t(lang,page.split('/')[0]),url:`/${lang}/${page.split('/')[0]}/`}]:[]),{name:title,url:`/${lang}/${page}/`}];
const details=tour?getTourDetails(tour):null;
const routePhotos=tour?[...new Set([tour.image,...tour.destinations.map(id=>getDestination(id).image)])].slice(0,2):[];
const catalogPage=['tours','inbound','outbound','domestic'].includes(page);
const policy=policies[page as keyof typeof policies];
---
<Base lang={lang} title={title} description={`${title}. ${description}`.slice(0,175)} path={page} image={image} breadcrumbs={breadcrumbs}>
{tour||destination||article?<section class="detail-hero wrap-wide"><Photo id={image} alt={gallery.find(g=>g.image===image)?.caption[lang]||title} priority sizes="100vw"/><div class="detail-hero-shade"></div><div class="wrap detail-hero-copy"><span class="eyebrow light">{tour?t(lang,'suggested'):article?t(lang,'journal'):destination!.country[lang]}</span><h1>{title}</h1>{tour&&<div class="detail-meta"><span><Icon name="clock"/>{duration(lang,tour.days)}</span><span><Icon name="globe"/>{t(lang,tour.style)}</span><span><Icon name="pin"/>{tour.destinations.map(x=>getDestination(x).name[lang]).join(' · ')}</span></div>}{article&&<p>{article.minutes} {t(lang,'minutes')}</p>}</div></section>:<section class:list={['page-heading','wrap',catalogPage&&'catalog-heading']}><span class="eyebrow orange">ALTAVIA / {t(lang,page==='credits'?'gallery':key)}</span><h1>{title}</h1><p>{description}</p></section>}
{catalogPage&&<section class="section wrap page-section"><Catalog lang={lang} type={page==='tours'?'':page}/></section>}
{tour&&<><div class="detail-tabs"><div class="wrap"><a href="#overview">{t(lang,'overview')}</a><a href="#attractions">{t(lang,'attractionsTitle')}</a><a href="#hotels">{t(lang,'hotelsTitle')}</a><a href="#itinerary">{t(lang,'itinerary')}</a><a href="#practical">{t(lang,'practical')}</a><a href={`/${lang}/contact/?tour=${tour.slug}`} class="tab-quote">{t(lang,'quote')}<Icon name="arrow" size={16}/></a></div></div><section class="section wrap tour-detail-layout"><div class="tour-story"><section id="overview"><span class="eyebrow orange">01 / {t(lang,'overview')}</span><h2>{t(lang,'highlights')}</h2><p class="lead">{tour.summary[lang]}</p><ul class="highlights">{details!.highlights.map(h=><li><Icon name="check"/>{h[lang]}</li>)}</ul>{routePhotos.length>1&&<div class="mini-photo-pair">{routePhotos.map((img)=><Photo id={img} alt={gallery.find(g=>g.image===img)?.caption[lang]||''}/>)}</div>}</section><TourAttractions tour={tour} lang={lang}/><section id="itinerary" class="detail-section"><span class="eyebrow orange">02 / {t(lang,'itinerary')}</span><h2>{t(lang,'itinerary')}</h2><p class="field-help">{t(lang,'quoteNote')}</p><div class="itinerary">{tour.itinerary.map((d,i)=><details open={i===0}><summary><span class="day-number">{String(d.day).padStart(2,'0')}</span><span><small>{t(lang,'day')} {d.day} · {getDestination(d.destination).name[lang]}</small>{d.title[lang]}</span><Icon name="chevron"/></summary><p>{d.description[lang]}</p></details>)}</div></section><section class="detail-section service-columns"><div><h3>{t(lang,'included')}</h3><ul>{details!.included.map(s=><li>{s[lang]}</li>)}</ul></div><div><h3>{t(lang,'excluded')}</h3><ul>{details!.excluded.map(s=><li>{s[lang]}</li>)}</ul></div></section><TourHotels tour={tour} lang={lang}/><section id="practical" class="detail-section"><h2>{t(lang,'practical')}</h2><div class="accordions">{(['accommodation','transport','suitable','practical'] as const).map(k=><details><summary>{t(lang,k)}<Icon name="chevron"/></summary><p>{details![k][lang]}</p></details>)}</div></section><section class="detail-section"><h2>{t(lang,'faq')}</h2><div class="accordions">{details!.faqs.map(f=><details><summary>{f.q[lang]}<Icon name="chevron"/></summary><p>{f.a[lang]}</p></details>)}</div></section></div><aside class="quote-panel"><span class="eyebrow orange">{t(lang,'suggested')}</span><h2>{tour.price!==null?`${t(lang,tour.priceStatus==='market-estimate'?'estimatedFrom':'fromPrice')} ${new Intl.NumberFormat(lang,{style:'currency',currency:tour.currency,maximumFractionDigits:0}).format(tour.price)}`:t(lang,'quote')}</h2><p>{t(lang,'perPerson')}</p><p>{t(lang,tour.priceStatus==='market-estimate'?'estimateNote':'quoteNote')}</p><dl><div><dt>{t(lang,'duration')}</dt><dd>{duration(lang,tour.days)}</dd></div><div><dt>{t(lang,'style')}</dt><dd>{t(lang,tour.style)}</dd></div><div><dt>{t(lang,'season')}</dt><dd>{tour.seasons.map(s=>t(lang,s)).join(' · ')}</dd></div></dl><a class="button" href={`/${lang}/contact/?tour=${tour.slug}`}>{t(lang,'quote')}<Icon name="arrow"/></a><a class="text-link" href={`/${lang}/custom/`}>{t(lang,'custom')}<Icon name="diagonal" size={16}/></a></aside></section><section class="section collection"><div class="wrap"><h2>{t(lang,'related')}</h2><div class="tour-grid">{tours.filter(x=>x.slug!==tour.slug&&(x.type===tour.type||x.countryId===tour.countryId)).slice(0,3).map(x=><TourCard tour={x} lang={lang}/>)}</div></div></section></>}
{page==='destinations'&&<section class="section wrap page-section">{['uzbekistan','international'].map(region=><div class="destination-group"><span class="eyebrow orange">{t(lang,region)}</span><h2>{t(lang,region==='uzbekistan'?'silkTitle':'discovery')}</h2><div class="destination-grid">{destinations.filter(d=>d.region===region).map(d=><a class="destination-tile" href={`/${lang}/destinations/${d.slug}/`}><Photo id={d.image} alt={gallery.find(g=>g.image===d.image)?.caption[lang]||d.name[lang]}/><div><span>{d.country[lang]}</span><h3>{d.name[lang]}</h3></div><span class="round-link"><Icon name="diagonal"/></span></a>)}</div></div>)}</section>}
{destination&&<><section class="section wrap destination-intro"><div><span class="eyebrow orange">{destination.country[lang]}</span><h2>{destination.name[lang]}</h2><p class="lead">{destination.summary[lang]}</p></div><aside class="destination-highlights"><h3>{t(lang,'highlights')}</h3>{destination.highlights.map((h,i)=><p><span>0{i+1}</span>{h[lang]}</p>)}</aside></section><section class="section collection"><div class="wrap"><h2>{t(lang,'tours')} · {destination.name[lang]}</h2><div class="tour-grid">{tours.filter(x=>x.destinations.includes(destination.slug)).map(x=><TourCard tour={x} lang={lang}/>)}</div></div></section><section class="section wrap destination-intro"><h2>{t(lang,'practical')}</h2><div><p>{serviceNotes.practical[lang]}</p><p>{serviceNotes.transport[lang]}</p><a class="text-link" href={`/${lang}/custom/`}>{t(lang,'custom')}<Icon name="arrow"/></a></div></section></>}
{(page==='contact'||page==='custom')&&<section class="section wrap page-section"><Inquiry lang={lang} planner={page==='custom'}/></section>}
{page==='gallery'&&<section class="section wrap page-section"><Gallery lang={lang}/><p class="field-help"><a href={`/${lang}/credits/`}>{t(lang,'credits')} ↗</a></p></section>}
{page==='about'&&<><section class="section wrap about-story"><div><Photo id="bukhara" alt={gallery.find(g=>g.image==='bukhara')!.caption[lang]} priority/></div><div><span class="eyebrow orange">ALTAVIA</span><h2>{t(lang,'customTitle')}</h2><p class="lead">{t(lang,'footerText')}</p><p>{t(lang,'customText')}</p><p>{t(lang,'whyText')}</p><CompanyContacts lang={lang}/><a class="button" href={`/${lang}/contact/`}>{t(lang,'contact')}<Icon name="arrow"/></a></div></section><section class="section collection"><div class="wrap"><h2>{t(lang,'whyTitle')}</h2><div class="why-items">{['why1','why2','why3'].map((k,i)=><div><span class="why-icon"><Icon name={['heart','check','globe'][i]}/></span><h3>{t(lang,k)}</h3><p>{t(lang,['customText','whyText','quoteNote'][i])}</p></div>)}</div></div></section></>}
{page==='journal'&&<section class="section wrap page-section"><div class="journal-grid journal-list">{articles.map(a=><article class="journal-card"><a href={`/${lang}/journal/${a.slug}/`}><Photo id={a.image} alt=""/><span class="eyebrow">{a.minutes} {t(lang,'minutes')}</span><h2>{a.title[lang]}</h2><p>{a.intro[lang]}</p><span class="text-link">{t(lang,'read')}<Icon name="arrow"/></span></a></article>)}</div></section>}
{article&&<article class="section article-body"><p class="lead">{article.intro[lang]}</p>{article.sections.map(s=><section><h2>{s.title[lang]}</h2><p>{s.body[lang]}</p></section>)}<div class="article-next"><a class="button" href={`/${lang}/custom/`}>{t(lang,'plan')}<Icon name="arrow"/></a><a class="text-link" href={`/${lang}/journal/`}>{t(lang,'journal')}<Icon name="arrow"/></a></div></article>}
{page==='faq'&&<section class="section wrap page-section"><div class="accordions faq-list">{faqs.map(f=><details><summary>{f.q[lang]}<Icon name="chevron"/></summary><p>{f.a[lang]}</p></details>)}</div></section>}
{policy&&<article class="section article-body page-section">{!company.policiesApproved&&<p class="notice">{t(lang,'review')}</p>}{company.legalName&&<p><strong>{company.legalName}</strong></p>}{company.privacyContact&&<p><a href={`mailto:${company.privacyContact}`}>{company.privacyContact}</a></p>}{policy.map(s=><section><h2>{s.title[lang]}</h2><p>{s.body[lang]}</p></section>)}<a class="text-link" href={`/${lang}/contact/`}>{t(lang,'contact')}<Icon name="arrow"/></a></article>}
{page==='credits'&&<section class="section wrap page-section"><p>{t(lang,'galleryText')}</p><div class="credit-grid">{media.map(m=><article><Photo id={m.id} alt={gallery.find(g=>g.image===m.id)?.caption[lang]||m.title}/><div><h2>{gallery.find(g=>g.image===m.id)?.caption[lang]||m.title}</h2><p>{m.author}</p><a href={m.sourceUrl} target="_blank" rel="noopener noreferrer">Wikimedia Commons ↗</a><a href={m.licenseUrl} target="_blank" rel="noopener noreferrer">{m.license} ↗</a><p class="field-help">{t(lang,'imageEdits')}</p></div></article>)}</div></section>}
{!['contact','custom','credits','privacy','terms','booking-conditions'].includes(page)&&<CTA lang={lang}/>}
</Base>
