---
import {t,type Lang} from '../data/i18n';import gallery from '../data/gallery.json';import Photo from './Photo.astro';import Icon from './Icon.astro';import media from '../data/media.json';
const {lang}=Astro.props as {lang:Lang};
---
<div data-gallery><div class="chips gallery-filters">{['all','uzbekistan','international','groups','culture','adventure','hotels','customers'].map((key,i)=><button class:list={['chip',i===0&&'active']} type="button" data-gallery-category={i===0?'':key} aria-pressed={i===0?'true':'false'}>{t(lang,key)}</button>)}</div><p class="gallery-count" aria-live="polite"></p><div class="masonry">{gallery.map((item)=>{const m=media.find(m=>m.id===item.image)!;return <figure data-gallery-item data-categories={item.categories.join(',')}><a class="gallery-open" href={m.variants[m.variants.length-1].src} data-full={m.variants[m.variants.length-1].src} data-caption={item.caption[lang]} data-credit={`${m.author} · ${m.license}`} data-source={m.sourceUrl}><Photo id={item.image} alt={item.caption[lang]} sizes="(max-width: 650px) 95vw, (max-width: 1000px) 45vw, 30vw"/><span class="gallery-zoom"><Icon name="diagonal"/></span></a><figcaption>{item.caption[lang]}<a href={m.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`© ${t(lang,'credits')}: ${item.caption[lang]}`} >©</a></figcaption></figure>})}</div><div class="empty-state" data-gallery-empty hidden><Icon name="sun" size={40}/><p>{t(lang,'galleryEmpty')}</p></div><dialog class="lightbox" aria-label={t(lang,'gallery')}><div class="lightbox-top"><span data-lightbox-counter></span><div><button class="icon-button" data-fullscreen aria-label={t(lang,'fullscreen')}><Icon name="diagonal"/></button><button class="icon-button" data-lightbox-close aria-label={t(lang,'close')}><Icon name="close"/></button></div></div><div class="lightbox-stage"><button class="icon-button previous" data-previous aria-label={t(lang,'previous')}>←</button><img data-lightbox-image alt="" width="1600" height="1000"/><button class="icon-button next" data-next-image aria-label={t(lang,'nextImage')}>→</button></div><div class="lightbox-caption"><p data-lightbox-caption></p><a data-lightbox-credit target="_blank" rel="noopener noreferrer"></a></div></dialog></div><script>import '../scripts/gallery';</script>
