---
import {t,languages,languageNames,type Lang} from '../data/i18n';import {tours,destinations} from '../data/travel';import Icon from './Icon.astro';import CompanyContacts from './CompanyContacts.astro';
const {lang,planner=false}=Astro.props as {lang:Lang;planner?:boolean};
const labels=Object.fromEntries(['sending','saved','savedNote','unavailable','invalid','rateLimited','technicalMode'].map(k=>[k,t(lang,k)]));
---
<div class:list={['inquiry-shell',planner&&'planner-shell']}><div class="inquiry-intro"><span class="eyebrow orange">{t(lang,planner?'custom':'contact')}</span><h2>{t(lang,planner?'customTitle':'step1')}</h2><p>{t(lang,planner?'plannerIntro':'contactText')}</p><ol class="inquiry-steps">{['step1','step2','step3'].map((k,i)=><li><span>0{i+1}</span>{t(lang,k)}</li>)}</ol><CompanyContacts lang={lang}/><p class="field-help">{t(lang,'noSensitive')}</p></div>
<div class="inquiry-panel"><div class="inquiry-status notice" data-api-status role="status" hidden></div><form id="inquiry-form" action="/api/inquiries/" method="post" data-inquiry data-planner={planner?'true':'false'} data-messages={JSON.stringify(labels)}>
{planner&&<><div class="wizard-progress" hidden><span data-step-label>1 / 3</span><div><i></i></div></div><fieldset data-step="0" class="planner-step"><legend>{t(lang,'where')}</legend><div class="destination-choices">{destinations.map(d=><label class="choice"><input type="checkbox" name="planDestination" value={d.name[lang]}/><span>{d.name[lang]}</span></label>)}</div><div class="form-grid"><label>{t(lang,'date')}<input type="date" name="planDate"/></label><label>{t(lang,'duration')}<input name="planDuration" type="number" min="1" max="90" value="7"/><small>{t(lang,'days')}</small></label></div><button type="button" data-next class="button wizard-only" hidden>{t(lang,'next')}<Icon name="arrow"/></button></fieldset><fieldset data-step="1" class="planner-step"><legend>{t(lang,'travelType')}</legend><div class="form-grid"><label>{t(lang,'pace')}<select name="planPace">{['relaxed','balanced','active'].map(k=><option>{t(lang,k)}</option>)}</select></label><label>{t(lang,'accommodation')}<select name="planAccommodation">{['boutique','comfort','luxury'].map(k=><option>{t(lang,k)}</option>)}</select></label></div><p class="field-label">{t(lang,'interests')}</p><div class="destination-choices">{['culture','beach','adventure','city'].map(k=><label class="choice"><input type="checkbox" name="planInterest" value={t(lang,k)}/><span>{t(lang,k)}</span></label>)}</div><div class="wizard-buttons"><button type="button" data-back class="button button-outline wizard-only" hidden>{t(lang,'back')}</button><button type="button" data-next class="button wizard-only" hidden>{t(lang,'next')}<Icon name="arrow"/></button></div></fieldset></>}
<fieldset data-step={planner?'2':'0'} class="contact-step"><legend>{t(lang,'contact')}</legend>{planner&&<div class="plan-review"><h3>{t(lang,'summary')}</h3><div data-plan-summary></div><button type="button" data-edit class="link-button wizard-only" hidden>{t(lang,'edit')}</button></div>}<div class="form-grid"><label class="span-2">{t(lang,'intentLabel')}<select name="intent"><option value="interested">{t(lang,'intentInterested')}</option><option value="ready-to-pay">{t(lang,'intentPay')}</option><option value="needs-info">{t(lang,'intentInfo')}</option></select></label><label class="span-2">{t(lang,'tours')}<select name="tour"><option value="custom">{t(lang,'custom')}</option>{tours.map(tour=><option value={tour.slug}>{tour.title[lang]}</option>)}</select></label><label>{t(lang,'name')} *<input name="name" autocomplete="name" required minlength="1" maxlength="100"/></label><label>{t(lang,'email')} *<input name="email" type="email" autocomplete="email" required maxlength="254"/></label><label>{t(lang,'phone')}<input name="phone" type="tel" autocomplete="tel" maxlength="40"/></label><label>{t(lang,'messaging')}<select name="messaging"><option value="email">{t(lang,'email')}</option><option value="phone">{t(lang,'phone')}</option><option value="whatsapp">WhatsApp</option><option value="telegram">Telegram</option></select></label><label class="span-2" data-handle-label hidden>Telegram @<input name="messagingHandle" maxlength="100"/></label><label>{t(lang,'date')}<input name="date" type="date"/></label><label>{t(lang,'departure')}<input name="departure" autocomplete="address-level2" maxlength="100"/></label><label>{t(lang,'adults')} *<input name="adults" type="number" min="1" max="50" value="2" required/></label><label>{t(lang,'children')}<input name="children" type="number" min="0" max="30" value="0" required/></label><label>{t(lang,'budget')}<input name="budget" type="number" min="0" max="1000000" step="1"/></label><label>{t(lang,'language')}<select name="language">{languages.map(l=><option value={l} selected={l===lang}>{languageNames[l]}</option>)}</select></label><label class="span-2">{t(lang,'requirements')}<textarea name="requirements" rows="4" maxlength="3000"></textarea></label></div><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="consent"><input type="checkbox" name="consent" required/><span>{t(lang,'consent')} <a href={`/${lang}/privacy/`} target="_blank" rel="noopener">{t(lang,'privacy')} ↗</a></span></label><div id="turnstile-widget"></div><div data-form-message role="status" tabindex="-1" hidden></div><div class="form-actions"><button type="submit" class="button">{t(lang,'submit')}<Icon name="arrow"/></button><button type="button" class="text-link download-button">{t(lang,'download')}</button></div><noscript><p class="notice">{t(lang,'unavailable')}</p></noscript></fieldset></form></div></div>
<script>import '../scripts/inquiry';</script>
