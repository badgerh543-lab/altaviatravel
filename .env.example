# Local preview works without any credentials. Never commit your .env.
# Local dev canonical/origin (use your verified HTTPS domain at production build):
SITE_URL=http://localhost:4321
API_PORT=8788
# Cloudflare dashboard secrets (do not prefix secrets with PUBLIC_):
# INQUIRY_ENCRYPTION_KEY=<32 random bytes, base64 encoded>
# RATE_LIMIT_SECRET=<at least 32 random characters>
# TURNSTILE_SECRET_KEY=<Cloudflare Turnstile secret>
# TURNSTILE_SITE_KEY=<public site key, used only by API status>
# BUSINESS_READY=true   # only after company details and policies are approved
# D1 binding name: DB (dashboard binding, not a string environment variable)

# Production private workspace (see docs/admin-panel.md):
# ADMIN_ENABLED=true
# CMS_BUILD_TOKEN=<independent random 40+ character secret; runtime AND build>
# CMS_SOURCE_URL=https://YOUR-VERIFIED-DOMAIN
# CMS_DEPLOY_HOOK=<private Cloudflare Pages or Workers build-hook URL; runtime only>
# First deployment uses repository content; configure export after the origin exists.
# Workers uses the private BACKEND Durable Object for sufficient password-hashing CPU.
# The alternative Pages adapter needs sufficient paid Workers CPU allowance.
