{
  "name": "altavia-travel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node --env-file-if-exists=.env scripts/sync-content.mjs && node --env-file-if-exists=.env scripts/validate-content.mjs && node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs build && node --env-file-if-exists=.env scripts/postbuild.mjs",
    "preview": "node --env-file-if-exists=.env scripts/dev.mjs --preview",
    "check": "astro check",
    "test": "node --test tests/backend.test.mjs tests/local-server.test.mjs tests/admin.test.mjs tests/seo.test.mjs",
    "test:e2e": "playwright test",
    "inquiries": "node scripts/inquiries.mjs",
    "media": "node scripts/prepare-media.mjs",
    "audit:runtime": "npm audit --omit=dev",
    "content:check": "node scripts/validate-content.mjs",
    "admin": "node --env-file-if-exists=.env scripts/admin.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/qrcode": "^1.5.6",
    "astro": "^7.4.12",
    "lighthouse": "^13.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
